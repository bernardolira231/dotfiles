#!/bin/bash

PLUGIN_DIR="$CONFIG_DIR/plugins"
MAIN_WORKSPACES=(1 2 3 4 5)
SECONDARY_WORKSPACES=(A S)

BG=0x3006080f
FG=0xfff3f6f9
# Sakura-friendly palette
ACCENT=0xffcba6f7
MUTED=0xff8a8fa3
SURFACE=0x40263356
SURFACE_SOFT=0x20263356

sketchybar --bar \
  position=top \
  height=37 \
  blur_radius=30 \
  color=$BG \
  corner_radius=0 \
  y_offset=0 \
  margin=0 \
  padding_left=10 \
  padding_right=10

default=(
  icon.font="IosevkaTerm Nerd Font Mono:Bold:15.0"
  label.font="IosevkaTerm Nerd Font Mono:Semibold:13.0"
  icon.color=$FG
  label.color=$FG
  icon.padding_left=10
  icon.padding_right=4
  label.padding_left=4
  label.padding_right=10
  padding_left=5
  padding_right=5
  background.color=$SURFACE_SOFT
  background.corner_radius=5
  background.height=24
)
sketchybar --default "${default[@]}"

# System icons with SF Symbols.
SYS_ICON_FONT="SF Pro:Semibold:15.0"

sketchybar --add event aerospace_workspace_change
sketchybar --add event bluetooth_change "com.apple.bluetooth.status"
sketchybar --add event network_refresh
sketchybar --add event tailscale_refresh
sketchybar --add event volume_refresh

# On reload, items may already exist (and keep old style props). Remove and re-add
# so new defaults/style are applied consistently.
sketchybar --remove launcher >/dev/null 2>&1
sketchybar --remove front_app >/dev/null 2>&1
sketchybar --remove network >/dev/null 2>&1
sketchybar --remove network.status >/dev/null 2>&1
sketchybar --remove network.ip >/dev/null 2>&1
sketchybar --remove network.settings >/dev/null 2>&1
sketchybar --remove tailscale >/dev/null 2>&1
sketchybar --remove tailscale.state >/dev/null 2>&1
sketchybar --remove tailscale.tailnet >/dev/null 2>&1
sketchybar --remove tailscale.ip >/dev/null 2>&1
sketchybar --remove tailscale.connect >/dev/null 2>&1
sketchybar --remove tailscale.disconnect >/dev/null 2>&1
sketchybar --remove tailscale.open >/dev/null 2>&1
sketchybar --remove bluetooth >/dev/null 2>&1
sketchybar --remove airpods >/dev/null 2>&1
sketchybar --remove volume >/dev/null 2>&1
sketchybar --remove volume.status >/dev/null 2>&1
sketchybar --remove volume.down >/dev/null 2>&1
sketchybar --remove volume.up >/dev/null 2>&1
sketchybar --remove volume.settings >/dev/null 2>&1
sketchybar --remove battery >/dev/null 2>&1
sketchybar --remove clock >/dev/null 2>&1

for ws in "${MAIN_WORKSPACES[@]}"; do
  sketchybar --remove "workspace.$ws" >/dev/null 2>&1
done

for ws in "${SECONDARY_WORKSPACES[@]}"; do
  sketchybar --remove "workspace.$ws" >/dev/null 2>&1
done

sketchybar --add item launcher left \
  --set launcher \
    icon=":raycast:" \
    label="" \
    icon.color=$ACCENT \
    icon.font="sketchybar-app-font:Regular:21.0" \
    icon.y_offset=-1 \
    background.drawing=off \
    padding_right=6 \
    click_script='open -a Raycast'

for ws in "${MAIN_WORKSPACES[@]}"; do
  sketchybar --add item "workspace.$ws" left \
    --set "workspace.$ws" \
      display=1 \
      icon="$ws" \
      label="" \
      label.drawing=on \
      label.y_offset=-1 \
      icon.font="IosevkaTerm Nerd Font Mono:Bold:19.0" \
      label.font="sketchybar-app-font:Regular:19.0" \
      label.padding_left=4 \
      label.padding_right=10 \
      background.height=26 \
      update_freq=5 \
      script="$PLUGIN_DIR/aerospace.sh $ws" \
      click_script="aerospace workspace $ws" \
      background.drawing=off \
    --subscribe "workspace.$ws" aerospace_workspace_change front_app_switched
done

for ws in "${SECONDARY_WORKSPACES[@]}"; do
  sketchybar --add item "workspace.$ws" left \
    --set "workspace.$ws" \
      display=2 \
      icon="$ws" \
      label="" \
      label.drawing=on \
      label.y_offset=-1 \
      icon.font="IosevkaTerm Nerd Font Mono:Bold:19.0" \
      label.font="sketchybar-app-font:Regular:19.0" \
      label.padding_left=4 \
      label.padding_right=10 \
      background.height=26 \
      update_freq=5 \
      script="$PLUGIN_DIR/aerospace.sh $ws" \
      click_script="aerospace workspace $ws" \
      background.drawing=off \
    --subscribe "workspace.$ws" aerospace_workspace_change front_app_switched
done


sketchybar --add item front_app center \
  --set front_app \
    display=active \
    icon.color=$ACCENT \
    icon.font="sketchybar-app-font:Regular:17.0" \
    icon.padding_right=2 \
    label.max_chars=28 \
    label.font="IosevkaTerm Nerd Font Mono:Semibold:15.0" \
    script="$PLUGIN_DIR/front_app.sh" \
    background.drawing=off \
  --subscribe front_app front_app_switched

sketchybar --add item network right \
  --set network \
    display=active \
    icon=􀙇 \
    icon.color=$ACCENT \
    icon.font="$SYS_ICON_FONT" \
    label.font="IosevkaTerm Nerd Font Mono:Semibold:15.0" \
    background.height=26 \
    update_freq=5 \
    label.max_chars=14 \
    script="$PLUGIN_DIR/network.sh" \
    click_script='sketchybar --trigger network_refresh; sketchybar --set network popup.drawing=toggle' \
    popup.align=right \
    popup.horizontal=off \
    popup.background.color=0xee10131b \
    popup.background.corner_radius=10 \
    popup.blur_radius=20 \
  --subscribe network wifi_change system_woke network_refresh

sketchybar --add item network.status popup.network \
  --set network.status icon=󰖩 label="Loading..." width=190 label.max_chars=24 background.drawing=on script="$PLUGIN_DIR/network.sh" \
  --subscribe network.status network_refresh

sketchybar --add item network.ip popup.network \
  --set network.ip icon=󰩟 label="-" width=190 label.max_chars=24 background.drawing=on script="$PLUGIN_DIR/network.sh" \
  --subscribe network.ip network_refresh

sketchybar --add item network.settings popup.network \
  --set network.settings icon=󰒓 label="Open Network Settings" width=190 background.drawing=on click_script='open "x-apple.systempreferences:com.apple.Network-Settings.extension"; sketchybar --set network popup.drawing=off'

sketchybar --add item tailscale right \
  --set tailscale \
    display=active \
    update_freq=10 \
    label.max_chars=14 \
    script="$PLUGIN_DIR/tailscale.sh" \
    icon=􀎛 \
    icon.font="$SYS_ICON_FONT" \
    label.font="IosevkaTerm Nerd Font Mono:Semibold:15.0" \
    background.height=26 \
    click_script='sketchybar --trigger tailscale_refresh; sketchybar --set tailscale popup.drawing=toggle' \
    popup.align=right \
    popup.horizontal=off \
    popup.background.color=0xee10131b \
    popup.background.corner_radius=10 \
    popup.blur_radius=20 \
  --subscribe tailscale system_woke tailscale_refresh

sketchybar --add item bluetooth right \
  --set bluetooth \
    display=active \
    icon="󰂯" \
    icon.color=$MUTED \
    label="" \
    icon.font="IosevkaTerm Nerd Font Mono:Bold:17.0" \
    label.font="IosevkaTerm Nerd Font Mono:Semibold:15.0" \
    background.height=26 \
    script="$PLUGIN_DIR/bluetooth.sh" \
  --subscribe bluetooth bluetooth_change

sketchybar --add item airpods right \
  --set airpods \
    display=active \
    icon=􀺹 \
    icon.color=$ACCENT \
    label="" \
    drawing=off \
    icon.font="$SYS_ICON_FONT" \
    label.font="IosevkaTerm Nerd Font Mono:Semibold:15.0" \
    background.height=26 \
    script="$PLUGIN_DIR/airpods_battery.sh" \
  --subscribe airpods bluetooth_change

sketchybar --add item tailscale.state popup.tailscale \
  --set tailscale.state icon=󰢹 label="Loading..." width=190 label.max_chars=24 background.drawing=on script="$PLUGIN_DIR/tailscale.sh" \
  --subscribe tailscale.state tailscale_refresh

sketchybar --add item tailscale.tailnet popup.tailscale \
  --set tailscale.tailnet icon=󰇧 label="-" width=190 label.max_chars=24 background.drawing=on script="$PLUGIN_DIR/tailscale.sh" \
  --subscribe tailscale.tailnet tailscale_refresh

sketchybar --add item tailscale.ip popup.tailscale \
  --set tailscale.ip icon=󰩟 label="-" width=190 label.max_chars=24 background.drawing=on script="$PLUGIN_DIR/tailscale.sh" \
  --subscribe tailscale.ip tailscale_refresh

sketchybar --add item tailscale.connect popup.tailscale \
  --set tailscale.connect icon=󰐊 label="Connect" width=190 background.drawing=on click_script="$PLUGIN_DIR/tailscale_toggle.sh up"

sketchybar --add item tailscale.disconnect popup.tailscale \
  --set tailscale.disconnect icon=󰅖 label="Disconnect" width=190 background.drawing=on click_script="$PLUGIN_DIR/tailscale_toggle.sh down"

sketchybar --add item tailscale.open popup.tailscale \
  --set tailscale.open icon=󰒓 label="Open Tailscale" width=190 background.drawing=on click_script='open -a Tailscale; sketchybar --set tailscale popup.drawing=off'

sketchybar --add item volume right \
  --set volume \
    display=active \
    icon.color=$ACCENT \
    icon.font="$SYS_ICON_FONT" \
    label.font="IosevkaTerm Nerd Font Mono:Semibold:15.0" \
    background.height=26 \
    script="$PLUGIN_DIR/volume.sh" \
    click_script='sketchybar --trigger volume_refresh; sketchybar --set volume popup.drawing=toggle' \
    popup.align=right \
    popup.horizontal=off \
    popup.background.color=0xee10131b \
    popup.background.corner_radius=10 \
    popup.blur_radius=20 \
  --subscribe volume volume_change volume_refresh

sketchybar --add item volume.status popup.volume \
  --set volume.status icon=󰕾 label="Volume" width=150 background.drawing=on script="$PLUGIN_DIR/volume.sh" \
  --subscribe volume.status volume_refresh volume_change

sketchybar --add item volume.settings popup.volume \
  --set volume.settings icon=󰒓 label="Open Sound Settings" width=150 background.drawing=on click_script='open "x-apple.systempreferences:com.apple.Sound-Settings.extension"; sketchybar --set volume popup.drawing=off'

sketchybar --add item battery right \
  --set battery display=active icon.color=$ACCENT icon.font="$SYS_ICON_FONT" label.font="IosevkaTerm Nerd Font Mono:Semibold:15.0" background.height=26 update_freq=120 script="$PLUGIN_DIR/battery.sh" click_script='open "x-apple.systempreferences:com.apple.Battery-Settings.extension"' \
  --subscribe battery system_woke power_source_change

sketchybar --add item clock right \
  --set clock display=active icon.color=$ACCENT icon.font="$SYS_ICON_FONT" label.font="IosevkaTerm Nerd Font Mono:Semibold:15.0" background.height=26 update_freq=10 icon=􀐫 script="$PLUGIN_DIR/clock.sh"

sketchybar --trigger aerospace_workspace_change FOCUSED_WORKSPACE="$(aerospace list-workspaces --focused)"
sketchybar --trigger network_refresh
sketchybar --trigger tailscale_refresh
sketchybar --trigger bluetooth_change
sketchybar --trigger volume_refresh
sketchybar --update
