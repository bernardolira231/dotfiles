#!/bin/bash

PLUGIN_DIR="$CONFIG_DIR/plugins"
MAIN_WORKSPACES=(1 2 3 4 5)
SECONDARY_WORKSPACES=(A S)

BG=0x3006080f
FG=0xfff3f6f9
ACCENT=0xffe0c15a
MUTED=0xff8a8fa3
SURFACE=0x40263356
SURFACE_SOFT=0x20263356

sketchybar --bar \
  position=top \
  height=28 \
  blur_radius=20 \
  color=$BG \
  corner_radius=0 \
  y_offset=0 \
  margin=0 \
  padding_left=6 \
  padding_right=6

default=(
  icon.font="IosevkaTerm Nerd Font Mono:Bold:13.0"
  label.font="IosevkaTerm Nerd Font Mono:Semibold:11.5"
  icon.color=$FG
  label.color=$FG
  icon.padding_left=5
  icon.padding_right=5
  label.padding_left=3
  label.padding_right=6
  padding_left=2
  padding_right=2
  background.color=$SURFACE_SOFT
  background.corner_radius=6
  background.height=18
)
sketchybar --default "${default[@]}"

sketchybar --add event aerospace_workspace_change
sketchybar --add event network_refresh
sketchybar --add event volume_refresh

for ws in "${MAIN_WORKSPACES[@]}"; do
  sketchybar --add item "workspace.$ws" left \
    --set "workspace.$ws" \
      display=1 \
      icon="$ws" \
      label="" \
      label.drawing=on \
      update_freq=5 \
      script="$PLUGIN_DIR/aerospace.sh $ws" \
      click_script="aerospace workspace $ws" \
      background.drawing=on \
    --subscribe "workspace.$ws" aerospace_workspace_change front_app_switched
done

for ws in "${SECONDARY_WORKSPACES[@]}"; do
  sketchybar --add item "workspace.$ws" left \
    --set "workspace.$ws" \
      display=2 \
      icon="$ws" \
      label="" \
      label.drawing=on \
      update_freq=5 \
      script="$PLUGIN_DIR/aerospace.sh $ws" \
      click_script="aerospace workspace $ws" \
      background.drawing=on \
    --subscribe "workspace.$ws" aerospace_workspace_change front_app_switched
done

sketchybar --add item front_app center \
  --set front_app \
    display=active \
    icon.color=$ACCENT \
    icon.padding_right=2 \
    label.max_chars=28 \
    script="$PLUGIN_DIR/front_app.sh" \
    background.drawing=off \
  --subscribe front_app front_app_switched

sketchybar --add item network right \
  --set network \
    display=active \
    update_freq=5 \
    label.max_chars=14 \
    script="$PLUGIN_DIR/network.sh" \
    click_script='sketchybar --trigger network_refresh; sketchybar --set network popup.drawing=toggle' \
    popup.align=right \
    popup.horizontal=off \
    popup.background.color=0xee10131b \
    popup.background.corner_radius=10 \
    popup.blur_radius=20 \
  --subscribe network wifi_change system_woke network_refresh

sketchybar --add item network.status popup.network \
  --set network.status icon=󰖩 label="Loading..." width=190 label.max_chars=24 background.drawing=on script="$PLUGIN_DIR/network.sh" \
  --subscribe network.status network_refresh

sketchybar --add item network.ip popup.network \
  --set network.ip icon=󰩟 label="-" width=190 label.max_chars=24 background.drawing=on script="$PLUGIN_DIR/network.sh" \
  --subscribe network.ip network_refresh

sketchybar --add item network.settings popup.network \
  --set network.settings icon=󰒓 label="Open Network Settings" width=190 background.drawing=on click_script='open "x-apple.systempreferences:com.apple.Network-Settings.extension"; sketchybar --set network popup.drawing=off'

sketchybar --add item volume right \
  --set volume \
    display=active \
    script="$PLUGIN_DIR/volume.sh" \
    click_script='sketchybar --trigger volume_refresh; sketchybar --set volume popup.drawing=toggle' \
    popup.align=right \
    popup.horizontal=off \
    popup.background.color=0xee10131b \
    popup.background.corner_radius=10 \
    popup.blur_radius=20 \
  --subscribe volume volume_change volume_refresh

sketchybar --add item volume.status popup.volume \
  --set volume.status icon=󰕾 label="Volume" width=150 background.drawing=on script="$PLUGIN_DIR/volume.sh" \
  --subscribe volume.status volume_refresh volume_change

sketchybar --add item volume.down popup.volume \
  --set volume.down icon=󰝞 label="Lower" width=150 background.drawing=on click_script="$PLUGIN_DIR/volume_control.sh down"

sketchybar --add item volume.up popup.volume \
  --set volume.up icon=󰝝 label="Raise" width=150 background.drawing=on click_script="$PLUGIN_DIR/volume_control.sh up"

sketchybar --add item volume.settings popup.volume \
  --set volume.settings icon=󰒓 label="Open Sound Settings" width=150 background.drawing=on click_script='open "x-apple.systempreferences:com.apple.Sound-Settings.extension"; sketchybar --set volume popup.drawing=off'

sketchybar --add item battery right \
  --set battery display=active update_freq=120 script="$PLUGIN_DIR/battery.sh" click_script='open "x-apple.systempreferences:com.apple.Battery-Settings.extension"' \
  --subscribe battery system_woke power_source_change

sketchybar --add item clock right \
  --set clock display=active update_freq=10 icon=󰥔 script="$PLUGIN_DIR/clock.sh"

sketchybar --trigger aerospace_workspace_change FOCUSED_WORKSPACE="$(aerospace list-workspaces --focused)"
sketchybar --trigger network_refresh
sketchybar --trigger volume_refresh
sketchybar --update
