[user]
	name = Bernardo Lira
	email = harritolira@gmail.com
	signingkey = /Users/bernardolira/.ssh/id_rsa
[core]
	excludesfile = /Users/bernardolira/.gitignore_global
	editor = windsurf --wait
	autocrlf = input
	sshCommand = "ssh -i ~/.ssh/id_rsa"
[difftool "sourcetree"]
	cmd = opendiff \"$LOCAL\" \"$REMOTE\"
	path = 
[mergetool "sourcetree"]
	cmd = /Applications/Sourcetree.app/Contents/Resources/opendiff-w.sh \"$LOCAL\" \"$REMOTE\" -ancestor \"$BASE\" -merge \"$MERGED\"
	trustExitCode = true
[credential]
	helper = osxkeychain
[commit]
	gpgSign = false
